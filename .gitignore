# Dependencies
/node_modules

# Next.js build output
/.next/
/out/

# Local env files
.env*.local
.env

# Personal financial data — never committed. See data/sample/ for fictional
# example data with the same structure, and README.md for how to plug in
# your own real data locally.
/data/*.csv
/data/*.xlsx
/data/*.xls
!/data/sample/
!/data/sample/**

# Daily news briefing — same bring-your-own-data model. Real briefings live
# in NEWS_BRIEFING_DIR (see .env.local); data/news/ is only a local fallback
# if that's unset, and feedback.jsonl logs your personal likes/dislikes.
/data/news/*.md
/data/news/*.jsonl

# Weekly meal plan — same bring-your-own-data model. Real plans live in
# MEAL_PLAN_DIR (see .env.local); data/meals/ is only a local fallback, and
# meal-feedback.jsonl logs the kids' per-dish thumbs up/down.
/data/meals/*.md
/data/meals/*.jsonl

# Misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tsconfig.tsbuildinfo
next-env.d.ts
