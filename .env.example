# Copy to .env.local (gitignored) and adjust for your machine.

# Real data (data/) and fictional demo data (sample-data/) live in two
# completely separate top-level folders — see lib/dataDir.ts for why. Which
# one is used is a hardcoded, explicit choice, not a silent "use real if it
# exists, else fall back to sample" check — you can always tell which one
# you're looking at by checking this one setting, not by guessing which
# files happen to exist on disk. Default (unset/false) is always data/. Set
# this to force every reader to use sample-data/ instead, regardless of
# what's in data/ (e.g. for screenshots or demoing the app without any real
# numbers on screen):
# USE_SAMPLE_DATA=true

# Where the real data folder lives. Defaults to data/ inside the repo; set
# this to keep it anywhere else on the machine (a relative path resolves
# against the repo root). Same reasoning as the folder settings below: this
# data isn't owned by the repo, so it shouldn't have to live inside it.
# Note this only relocates the real folder — it does NOT decide between real
# and sample data, which is still USE_SAMPLE_DATA's job alone. A DATA_DIR
# pointing at a folder that doesn't exist renders as empty/error state; it
# never silently falls back to sample-data/.
DATA_DIR=/Users/you/Documents/Claude/life-dashboard-data

# Folder containing dated YYYY-MM-DD-news-summary.md files from the
# daily-news scheduled task. If unset, the app reads from data/news/ (or
# sample-data/news/ if USE_SAMPLE_DATA=true) instead.
NEWS_BRIEFING_DIR=/Users/you/Documents/Claude/Daily-Briefing/email-news

# Folder containing dated Weekly_Plan_YYYY-MM-DD.md files from the weekly
# food-planning task. If unset, the app reads from data/meals/ (or
# sample-data/meals/ if USE_SAMPLE_DATA=true) instead.
MEAL_PLAN_DIR=/Users/you/Documents/Claude/Food-Planning/weekly-plans

# Folder containing Food_list.md and its recipes/ subfolder (the parent of
# MEAL_PLAN_DIR above) — used by the /recipes page. If unset, the app reads
# from data/food/ (or sample-data/food/ if USE_SAMPLE_DATA=true) instead.
FOOD_PLANNING_DIR=/Users/you/Documents/Claude/Food-Planning

# Passcode that gates the /resources page (saved links + file attachments).
# If unset, the page is left unlocked (handy for local dev against sample
# data). The gate uses a 10-minute sliding session — it locks again after
# 10 minutes of inactivity, or whenever the cookie's window lapses (e.g. the
# laptop was asleep/locked).
RESOURCES_PASSCODE=changeme

# Passcode that gates the /learning page. Same unlocked-if-unset behavior
# and 10-minute sliding session as RESOURCES_PASSCODE above — set
# independently so the two sections can use different codes.
LEARNING_PASSCODE=changeme

# Passcode that gates the Finance dashboard (the "/finance" route). Same
# unlocked-if-unset behavior and 10-minute sliding session as
# RESOURCES_PASSCODE above — set independently so the two sections can use
# different codes.
FINANCE_PASSCODE=changeme

# Folder containing the raw WhatsApp chat exports used by the /tori-photos
# page (three subfolders, one per exported chat thread — see lib/toriPhotos.ts
# for the exact expected names). If unset, the page has no data to show.
TORI_PHOTOS_DIR=/Users/you/Documents/Claude/Whatsapp - Tori

# ONE passcode for all three of the boys' pages — /tori-photos,
# /milo-nursery and /arlo-nursery. They share a single cookie (see
# lib/kidsPhotosAuth.ts), so typing this on any one of them unlocks all
# three for the 10-minute sliding session. Same unlocked-if-unset behavior
# as the other passcodes above: if neither this nor any of the three older
# per-page variables below is set, all three pages stay open.
#
# Set it to something DIFFERENT from FAMILY_PASSCODE — these three pages are
# household-only, the /family section is the one that's shared outside.
KIDS_PASSCODE=changeme

# Legacy, still honored: before the three pages shared one gate they each
# had their own passcode. If KIDS_PASSCODE is unset, the first of these
# three that IS set becomes the passcode for all three pages — so an old
# .env.local keeps working untouched. Setting them to different values no
# longer gives the pages different passcodes; prefer KIDS_PASSCODE above.
TORI_PHOTOS_PASSCODE=changeme

# Folder containing Milo's nursery photos — a flat folder of plain jpegs
# (e.g. exported from Photos/a nursery app), not a WhatsApp chat export, so
# lib/miloNurseryPhotos.ts groups them by day using each file's EXIF
# DateTimeOriginal instead of chat-log timestamps. If unset, the page has no
# data to show.
MILO_NURSERY_PHOTOS_DIR=/Users/you/Documents/Claude/Photos/Milo nursery BH 2024-2026

# Legacy fallback for KIDS_PASSCODE — see the note there.
MILO_NURSERY_PHOTOS_PASSCODE=changeme

# Folder containing Arlo's nursery updates, used by the /arlo-nursery page —
# a nested <dir>/<year>/<month name>/ tree, each month folder holding the
# actual photos taken that month (date-prefixed filenames, "YYYY-MM-DD_IMG_
# ####.jpeg") plus an optional updates.md (Bright Horizons app data —
# meals/naps/nappies/observations — compiled per day, "### <Weekday, Mon DD,
# YYYY>" headers; see lib/arloNurseryPhotos.ts). Each month folder's
# completed/ subfolder holds the raw app screenshots updates.md was compiled
# from, not photos of Arlo, and is deliberately skipped. If unset, the page
# has no data to show.
ARLO_NURSERY_PHOTOS_DIR=/Users/you/Documents/Claude/Photos/Arlo nursery

# Folder holding the unzipped WhatsApp export of the "Chiarline - Milo -
# Arlo" group, used by the second half of the /arlo-nursery page. Point it
# at the folder that *contains* the dated export subfolder(s) — those are
# discovered automatically, so a fresh re-export just drops in alongside
# (see lib/chiarlineDays.ts). Photos come from the messages Chiarline
# attached; the day's write-up comes from what she typed. Shares the
# /arlo-nursery passcode, since it's the same page.
CHIARLINE_DIR=/Users/you/Documents/Claude/Photos/Chiarline - Milo - Arlo

# Legacy fallback for KIDS_PASSCODE — see the note there.
ARLO_NURSERY_PHOTOS_PASSCODE=changeme

# Passcode for the /family section — the cut-down, grandparent-facing view
# (photos of the boys + Gatehouse news). This is the only code shared
# outside the household, so set it to something DIFFERENT from every
# passcode above; see FAMILY-ACCESS.md for the Tailscale Serve setup that
# restricts what's reachable in the first place.
FAMILY_PASSCODE=changeme

# Folder containing Gatehouse school communications, used by the /gatehouse
# page: messages/*.md (one file per email or WhatsApp message/thread, with
# YAML-ish frontmatter — see lib/gatehouse.ts for the exact shape), files/
# (attachments referenced from messages), and reports/*.md (hand-written
# weekly digests referencing message ids via [[msg:id]] — see
# lib/gatehouseReports.ts). Not passcode-gated. If unset, the page has no
# data to show.
GATEHOUSE_DIR=/Users/you/Documents/Claude/Milo-Gatehouse

# Read-only live connection to an iCloud calendar over CalDAV, used by the
# /family/calendar week view. Unlike every other source above there's no
# local file involved — this talks to Apple's servers on each page load.
# Generate an app-specific password at appleid.apple.com -> Sign-In and
# Security -> App-Specific Passwords, and never reuse the real Apple ID
# password here. If either is unset the page shows a "not connected"
# message with these steps instead of erroring. lib/troettgerCalendar.ts
# only ever calls fetchCalendars/fetchCalendarObjects — there is no
# create/update/delete path in it at all.
ICLOUD_CALDAV_USERNAME=your-apple-id@example.com
ICLOUD_CALDAV_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Which calendar the family week view reads. iCloud matches on the
# calendar's DISPLAY NAME, so renaming it in the Calendar app detaches it
# from here (the page says so rather than rendering an empty week).
# Defaults to "Social Troettger AI" if unset.
ICLOUD_SOCIAL_CALENDAR_NAME=Social Troettger AI

# Optional, only used if the private dashboard's own calendar/reminders
# code is revived — both default to "Troettger AI".
# ICLOUD_CALENDAR_NAME=Troettger AI
# ICLOUD_REMINDERS_LIST=Troettger AI

# Folder holding discount/voucher codes for the /shopping/vouchers page:
# one or more markdown files containing a table with at least a voucher-code
# column, e.g.
#   | Webpage | Voucher code | Expiry date | Notes |
# Columns are matched by header NAME rather than position, so adding or
# reordering one upstream won't shift the values. The expiry cell is free
# text ("31/12/2026 (11pm)", "~02/11/2026") — a date is extracted from it
# where possible for the countdown, and the original string is still shown.
# Nothing in this app writes to that folder. If unset, the page says so.
VOUCHERS_DIR=/Users/you/Documents/Claude/Vouchers
