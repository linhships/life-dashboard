# Copy to .env.local (gitignored) and adjust for your machine.

# Real data (data/) and fictional demo data (sample-data/) live in two
# completely separate top-level folders — see lib/dataDir.ts for why. Every
# reader below prefers a real file in data/ and only falls back to the
# matching file in sample-data/ if the real one doesn't exist yet, so you
# never need to run a seed/copy script. Set this to force every reader to
# use sample-data/ regardless of what's in data/ (e.g. for screenshots or
# demoing the app without any real numbers on screen):
# USE_SAMPLE_DATA=true

# Folder containing dated YYYY-MM-DD-news-summary.md files from the
# daily-news scheduled task. If unset, the app falls back to sample-data/news/.
NEWS_BRIEFING_DIR=/Users/you/Documents/Claude/Daily-Briefing/email-news

# Folder containing dated Weekly_Plan_YYYY-MM-DD.md files from the weekly
# food-planning task. If unset, the app falls back to sample-data/meals/.
MEAL_PLAN_DIR=/Users/you/Documents/Claude/Food-Planning/weekly-plans

# Folder containing Food_list.md and its recipes/ subfolder (the parent of
# MEAL_PLAN_DIR above) — used by the /recipes page. If unset, the app falls
# back to sample-data/food/.
FOOD_PLANNING_DIR=/Users/you/Documents/Claude/Food-Planning

# Passcode that gates the /links page. If unset, the page is left unlocked
# (handy for local dev against sample data). The gate uses a 10-minute
# sliding session — it locks again after 10 minutes of inactivity, or
# whenever the cookie's window lapses (e.g. the laptop was asleep/locked).
LINKS_PASSCODE=changeme

# Passcode that gates the /learning page. Same unlocked-if-unset behavior
# and 10-minute sliding session as LINKS_PASSCODE above — set independently
# so the two sections can use different codes.
LEARNING_PASSCODE=changeme

# Passcode that gates the Finance dashboard (the "/" route). Same
# unlocked-if-unset behavior and 10-minute sliding session as LINKS_PASSCODE
# above — set independently so the two sections can use different codes.
FINANCE_PASSCODE=changeme

# Folder containing the raw WhatsApp chat exports used by the /tori-photos
# page (three subfolders, one per exported chat thread — see lib/toriPhotos.ts
# for the exact expected names). If unset, the page has no data to show.
TORI_PHOTOS_DIR=/Users/you/Documents/Claude/Whatsapp - Tori

# Passcode that gates the /tori-photos page. Same unlocked-if-unset behavior
# and 10-minute sliding session as the other passcodes above.
TORI_PHOTOS_PASSCODE=changeme

# Folder containing Milo's nursery photos — a flat folder of plain jpegs
# (e.g. exported from Photos/a nursery app), not a WhatsApp chat export, so
# lib/miloNurseryPhotos.ts groups them by day using each file's EXIF
# DateTimeOriginal instead of chat-log timestamps. If unset, the page has no
# data to show.
MILO_NURSERY_PHOTOS_DIR=/Users/you/Documents/Claude/Photos/Milo nursery BH 2024-2026

# Passcode that gates the /milo-nursery page. Same unlocked-if-unset behavior
# and 10-minute sliding session as the other passcodes above.
MILO_NURSERY_PHOTOS_PASSCODE=changeme

# Read-only live connection to an iCloud calendar + Reminders list (the
# /calendar page) via CalDAV — unlike everything above, there's no local
# file involved; this talks to Apple's servers on every page load. If
# unset, the page shows a "not connected" message instead of erroring.
# Generate an app-specific password at appleid.apple.com -> Sign-In and
# Security -> App-Specific Passwords (never reuse your real Apple ID
# password here). This module only ever reads your calendar/reminders —
# it has no create/update/delete code paths at all.
ICLOUD_CALDAV_USERNAME=your-apple-id@example.com
ICLOUD_CALDAV_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional — only needed if your calendar/reminders list isn't literally
# named "Troettger AI". Both default to "Troettger AI" if unset.
ICLOUD_CALENDAR_NAME=Troettger AI
ICLOUD_REMINDERS_LIST=Troettger AI
